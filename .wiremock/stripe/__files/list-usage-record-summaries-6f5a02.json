  "data": [
    {
      "id": "sis_{{request.path.subscription_item}}",
      "object": "usage_record_summary",
      "invoice": null,
      "livemode": false,
      "period": {
        "end": null,
        "start": null
      },
      "subscription_item": "{{request.path.subscription_item}}",
      "total_usage": {{tot}}
    }
  ],
  "has_more": false,
  "url": "/v1/subscription_items/{{request.path.subscription_item}}/usage_record_summaries"
}
{{/formatJson}}