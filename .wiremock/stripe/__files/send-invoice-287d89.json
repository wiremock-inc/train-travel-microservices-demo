{{val (state id context=(stringFormat 'invoices%s' sfx)) assign='inv'}}{{val 0 assign='sub'}}{{val 0 assign='cnt'}}{{#each (listState linesCtx) as |l|}}{{#unless (jsonPath l '$.none')}}{{val (math sub '+' (jsonPath l '$.amount')) assign='sub'}}{{val (math cnt '+' 1) assign='cnt'}}{{/unless}}{{/each}}{{val (jsonPath inv '$.status') assign='st'}}{{val 0 assign='paid'}}{{val sub assign='rem'}}{{#eq st 'paid'}}{{val sub assign='paid'}}{{val 0 assign='rem'}}{{/eq}}{{#eq st 'void'}}{{val 0 assign='rem'}}{{/eq}}{{#formatJson}}{{#jsonMerge inv}}
{
  "subtotal": {{sub}},
  "subtotal_excluding_tax": {{sub}},
  "total": {{sub}},
  "total_excluding_tax": {{sub}},
  "amount_due": {{sub}},
  "amount_paid": {{paid}},
  "amount_remaining": {{rem}},
  "lines": {
    "object": "list",
    "data": [{{val '' assign='acc'}}{{#each (listState linesCtx) as |l|}}{{#unless (jsonPath l '$.none')}}{{#if acc}}{{val (stringFormat '%s,%s' l acc) assign='acc'}}{{else}}{{val l assign='acc'}}{{/if}}{{/unless}}{{/each}}{{{acc}}}
