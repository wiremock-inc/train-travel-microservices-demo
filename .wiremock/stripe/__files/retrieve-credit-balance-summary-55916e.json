{{val 0 assign='tot'}}{{val 'usd' assign='cur'}}{{#each (listState (stringFormat 'credit_grants%s' sfx)) as |g|}}{{#eq (jsonPath g '$.customer') request.query.customer.0}}{{#unless (jsonPath g '$.voided_at')}}{{#unless (jsonPath g '$.expires_at')}}{{val (math tot '+' (jsonPath g '$.amount.monetary.value')) assign='tot'}}{{val (jsonPath g '$.amount.monetary.currency') assign='cur'}}{{/unless}}{{/unless}}{{/eq}}{{/each}}{{#formatJson}}
{
  "object": "billing.credit_balance_summary",
  "balances": [
    {
      "available_balance": {
        "monetary": {
          "currency": "{{cur}}",
          "value": {{tot}}
        },
        "type": "monetary"
      },
      "ledger_balance": {
        "monetary": {
          "currency": "{{cur}}",
          "value": {{tot}}
        },
        "type": "monetary"
      }
    }
  ],
  "customer": "{{request.query.customer.0}}",
  "customer_account": null,
  "livemode": false
}
{{/formatJson}}